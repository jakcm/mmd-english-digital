<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏：左右结构 —— 左侧（左上角按钮 + 整屏竖直居中的头像/电话/状态），右侧对话内容（纵向撑满） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_root"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <!-- ============ 左栏：按钮绝对贴左上角，头像+电话/状态整组在整屏竖直居中 ============ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- 左上角按钮：顺序为【先关闭、再设置】（绝对定位，不参与整组居中计算） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_ghost"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/close_app" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_ghost"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <!-- 头像 + 电话/状态：整组相对整个左栏（即整屏高度）竖直居中 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- 数字人头像（下方不再显示任何文字） -->
            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:background="@drawable/bg_avatar_ring"
                android:clipToOutline="true">

                <TextureView
                    android:id="@+id/avatarView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 电话图标（头像下方）+ 状态文字（在电话图标右侧，无图标无背景色） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnCall"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_btn_primary"
                    android:src="@drawable/ic_phone"
                    android:scaleType="centerInside"
                    android:padding="18dp"
                    android:tint="@color/bg_top"
                    android:contentDescription="@string/btn_call" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:maxWidth="220dp"
                    android:text="@string/status_idle"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ 右栏：对话内容区（纵向撑满窗口） ============ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_card">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/bubbleBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

</LinearLayout>