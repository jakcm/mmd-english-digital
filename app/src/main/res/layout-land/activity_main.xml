<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_ghost"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/settings" />

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_ghost"
            android:src="@drawable/ic_rotate"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/rotate" />
    </LinearLayout>

    <!-- 内容：左头像 / 右面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- 左：数字人 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:background="@drawable/bg_avatar_ring"
                android:clipToOutline="true">

                <TextureView
                    android:id="@+id/avatarView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/avatar_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/avatar_sub"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 右：状态/字幕/控制 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/status_idle"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:maxLines="2" />

                <Switch
                    android:id="@+id/swAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:checked="true"
                    android:text="@string/auto_mode"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card">

                <ScrollView
                    android:id="@+id/scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/transcript"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:text="" />
                </ScrollView>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnTest"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:src="@drawable/ic_wave"
                    android:scaleType="centerInside"
                    android:padding="14dp"
                    android:tint="@color/text_primary"
                    android:contentDescription="@string/btn_test" />

                <ImageButton
                    android:id="@+id/btnCall"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_btn_primary"
                    android:src="@drawable/ic_phone"
                    android:scaleType="centerInside"
                    android:padding="18dp"
                    android:tint="@color/bg_top"
                    android:contentDescription="@string/btn_call" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
